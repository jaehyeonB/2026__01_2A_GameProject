{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6c740d653ca34ad5905fde345be1fcd6",
    "m_Title": "화면을 왜곡하는 기반",
    "m_Content": "화면 좌표를 노이즈로 살짝 흔들어서 왜곡 효과를 만드는 구조\n\n기존 화면 좌표 + 노이즈 기반 오포셋 = 왜곡된 좌표\n\n픽셀 위치를 살짝 밀어버림 ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 645.0,
        "y": -876.0,
