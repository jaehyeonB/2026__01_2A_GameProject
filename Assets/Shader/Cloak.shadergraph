{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "4dc53d699b2f471cb457fbdb30e03b61",
    "m_Title": "왜곡된 좌표로 화면들 다시 샘플링 하는 단계",
    "m_Content": "Screen Position + 왜곡 값\n-> 이미 여기서 좌표가 휘어진 상태\n\nScene Colour\n화면에 이미 랜더된 색을 가져오는 노드\n-> 카메라가 보고 있는 화면\n\nadd 출력 -> Scene Colour 의 UV 로 들어감 ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 981.0,
        "y": -785.0,
        "width": 414.0,
        "height": 160.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

